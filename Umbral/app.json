{
  "expo": {
    "name": "Umbral",
    "slug": "umbral",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "umbral",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.edu.uner.umbral",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app requiere acceso a la cámara para escanear códigos QR de promociones."
      }
    },
    "android": {
      "package": "ar.edu.uner.umbral",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#F2F4F7"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#7C8CE0"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Umbral usa Face ID para confirmar que sos vos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F4F7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Umbral usa tu ubicación para mostrarte los comercios más cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Umbral usa la cámara para sacar fotos y grabar el video de tu comercio."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f21f1110-6fed-4bff-993b-7a8131558324"
      }
    },
    "owner": "valentina_angeletti22"
  }
}
