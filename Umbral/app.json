{
  "expo": {
    "name": "Umbral",
    "slug": "Umbral",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "umbral",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app requiere acceso a la cámara para escanear códigos QR de promociones.",
        "NSLocationWhenInUseUsageDescription": "Umbral usa tu ubicación para mostrarte los comercios más cercanos y verte en el mapa."
      },
      "bundleIdentifier": "com.grupo6.umbral"
    },
    "android": {
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.grupo6.umbral",
      "adaptiveIcon": {
        "backgroundColor": "#F2F4F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F4F7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Umbral usa tu ubicación para mostrarte los comercios más cercanos y verte en el mapa."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Umbral usa la cámara para escanear los códigos QR de las promociones.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Umbral usa tus fotos para que el comercio cargue imágenes y video en su ficha.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/images/icon.png"
  }
}
